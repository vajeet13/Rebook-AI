# MongoDB connection string (host/cluster; database name defaults to `users` via MONGO_DB_NAME).
MONGO_URI=


# Optional: if Atlas SRV fails with querySrv ECONNREFUSED on Windows, set DNS (comma-separated).
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# Alternative fix: use the non-SRV connection string from Atlas (Connection -> Drivers),
# mongodb://host1:27017,... instead of mongodb+srv:// (avoids _mongodb._tcp SRV lookup).

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PORT=3000

# Comma-separated browser origins allowed for CORS (Flutter web + API).
# Default in server.js includes Netlify preview + localhost if unset.
# ALLOWED_ORIGINS=https://regal-mochi-ba82b6.netlify.app,http://localhost:8080

# --- Rebook AI / Bolna (optional until you wire voice) ---
# Outbound calls: POST https://api.bolna.ai/call — see https://www.bolna.ai/docs/api-reference/calls/make.md
# BOLNA_API_BASE=https://api.bolna.ai
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# Webhook: set Analytics tab URL to https://your-host/api/webhooks/bolna — pass user_data.appointmentId from calls.
# Optional: BOLNA_WEBHOOK_SECRET=... and use POST /api/webhooks/bolna?token=...
# BOLNA_WEBHOOK_VERIFY_IP=true
# BOLNA_WEBHOOK_IPS=13.203.39.153
#
# Bolna extractions (example keys): appointment_outcome (confirmed|cancelled|reschedule), cancellation_reason, new_slot_iso, appointmentId
#
# Confirmation batch window (POST /api/internal/trigger-confirmation-calls requires JWT).
CONFIRMATION_LEAD_MINUTES=120
CONFIRMATION_LEAD_WINDOW_MINUTES=15
